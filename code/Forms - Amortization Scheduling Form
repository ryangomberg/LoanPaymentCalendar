Private Sub ClearButton_Click()
' Clear contents in each TextBox

    Dim ctrl As Control
    For Each ctrl In Me.Controls
        If TypeName(ctrl) = "ComboBox" Or TypeName(ctrl) = "TextBox" Then
            ctrl.Value = ""
        ElseIf TypeName(ctrl) = "CheckBox" Then
            ctrl.Value = False
        End If
    Next ctrl
End Sub

