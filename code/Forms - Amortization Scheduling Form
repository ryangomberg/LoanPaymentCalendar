Private Function MissingInputs() As Boolean
' Return an error pop-up if one or more of the following conditions are not met:
' 1. Any TextBox contains no value
' 2. Entries requiring numeric values (ex. loan amount, payment frequency) does not contain a numeric value (ex. date, text)
' 3. Entries for the loan amount TextBox contain a $ sign
' 4. Interest rate is not expressed in decimal form
' 5. The first payment date is not expressed in the mm/dd/yyyy format

' Checking Condition 1
    Dim ctrl As Control
    For Each ctrl In Me.Controls
        If TypeName(ctrl) = "TextBox" Then
            If Trim(ctrl.Value) = "" Then
                MsgBox ("Please fill in each box before submitting")
                Exit Function
            End If
        End If
    Next ctrl

' Checking Condition 2
    If Not IsNumeric(LoanAmountTxtbox) _
    Or Not IsNumeric(LoanIRTxtbox) _
    Or Not IsNumeric(NumPmtsTxtbox) _
    Or Not IsNumeric(PmtFreqTxtbox) Then
        MsgBox ("Numeric field must contain numbers only (Loan Amount, Loan Interest Rate, Number of Payments, Payment Frequency). Please review the requirements before submitting.")
        Exit Function
    End If

' Checking Condition 3
    If InStr(LoanAmountTxtbox.Value, "$") > 0 Then
        MsgBox ("Please remove '$' from the loan amount")
        Exit Function
    End If

' Checking Condition 4
    If CDbl(LoanIRTxtbox) > 1 Then
        MsgBox ("Interest rate must be expressed in decimal form")
        Exit Function
    End If

' Checking Condition 5
    If Not IsDate(FirstPmtTextbox.Value) Then
        MsgBox ("Date must be in MM/DD/YYYY format")
        Exit Function
    End If
    
MissingInputs = True

End Function

