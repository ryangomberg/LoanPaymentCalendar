Private Sub BuildSchedule()
' Builds the loan amortization calendar for each borrower
' Variable List:
' Workbooks: cal
' Worksheets: ws, monthSheet, wsMD
' ListObject: tbl
' ListRow: newRow
' Date: calStart, calEnd, pmtDate
' Double: loanamt, annRate, rate, pmts, bal, balloonBalance, balloonPmt, interest, principal
' Integer: pmtFreq, numPmts, i

Dim ws As Worksheet
Dim cal As Workbook
Dim monthSheet As Worksheet
Dim calStart As Date
Dim calEnd As Date
Dim loanamt As Double
Dim annRate As Double
Dim pmtFreq As Integer
Dim numPmts As Integer
Dim rate As Double
Dim pmts As Double
Dim bal As Double
Dim balloonBalance As Double
Dim balloonPmt As Double
Dim interest As Double
Dim principal As Double
Dim pmtDate As Date
Dim i As Integer

Dim tbl As ListObject
Dim newRow As ListRow
Dim wsMD As Worksheet

' Set calendar duration from 03/01/2026 to 02/28/2027
calStart = DateSerial(2026, 3, 1)
calEnd = DateSerial(2027, 2, 28)

' Set the master calendar and amortization table
Set cal = Workbooks("Loan Payment Calendar.xlsx")
Set amort = Workbooks("Loan Amortization Userform.xlsm")

' Set current worksheet to Master Data and current table to MData
Set wsMD = cal.Sheets("Master Data")
Set tbl = wsMD.ListObjects("MData")

' Translate entries for numerical text boxes into variables
loanamt = CDbl(LoanAmountTxtbox.Value)
annRate = CDbl(LoanIRTxtbox.Value)
pmtFreq = CInt(PmtFreqTxtbox)
numPmts = CInt(NumPmtsTxtbox)

' Converting to m-thly interest rate
rate = (1 + annRate) ^ (1 / pmtFreq) - 1

' Set outstanding balance equal to loan amount and payment date to 
' the entry in the first payment TextBox
' This is the first period of the amortization schedule
bal = loanamt
pmtDate = CDate(FirstPmtTextbox.Value)

' Add a new worksheet at the end of the scheduling workbook (amort) and set it as the current worksheet
' Name the current worksheet after the borrower's full name
Set ws = amort.Sheets.Add(After:=Sheets(Sheets.Count))
ws.Name = FullNameTxtbox.Value

' Set values for A1 to E1 as the amortization schedule values
ws.Range("A1:E1") = Array("Date", "Payment", "Principal", "Interest", "Balance")

' Calculate payment installations
pmts = Round(Application.WorksheetFunction.pmt(rate, numPmts, -loanamt), 2)

' Iterate amortization over the number of payments
For i = 1 To numPmts
    ' Interest and principal calculations
    interest = Round(bal * rate, 2)
    principal = Round(pmts - interest, 2)

    ' Set outstanding balance
    bal = bal - principal

    ' Fill in information for (i + 1)th row through columns A-E
    ws.Cells(i + 1, 1) = pmtDate
    ws.Cells(i + 1, 2) = pmts
    ws.Cells(i + 1, 3) = principal
    ws.Cells(i + 1, 4) = interest
    ws.Cells(i + 1, 5) = bal

    ' Add same information to the monthly calendar on the next row 
    If pmtDate >= calStart And pmtDate <= calEnd Then
        sheetName = Format(pmtDate, "mmm yyyy")
        
        On Error Resume Next
        Set monthSheet = cal.Sheets(sheetName)
        On Error GoTo 0
        
        If monthSheet Is Nothing Then
            Set monthSheet = cal.Sheets.Add
            monthSheet.Name = sheetName
            monthSheet.Range("A1:E1") = Array("Borrower", "Date", "Payment", "Principal", "Interest")
        End If

    nextRow = monthSheet.Cells(monthSheet.Rows.Count, 1).End(xlUp).Row + 1
    
    monthSheet.Cells(nextRow, 1) = FullNameTxtbox.Value
    monthSheet.Cells(nextRow, 2) = pmtDate
    monthSheet.Cells(nextRow, 3) = pmts
    monthSheet.Cells(nextRow, 4) = principal
    monthSheet.Cells(nextRow, 5) = interest
    
    Set newRow = tbl.ListRows.Add
    newRow.Range(1, 1).Value = FullNameTxtbox.Value
    newRow.Range(1, 2).Value = pmtDate
    newRow.Range(1, 3).Value = pmts
    newRow.Range(1, 4).Value = principal
    newRow.Range(1, 5).Value = interest
    
    End If
    
    pmtDate = DateAdd("m", 12 / pmtFreq, pmtDate)
    
Next i

' Format columns B-E to USD currency and A as a date
ws.Columns("B:E").NumberFormat = "$#,##0.00"
ws.Columns("A").NumberFormat = "mm/dd/yyyy"

End Sub

